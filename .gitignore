node_modules/

# ⚠️ dist/ 必须提交，不要加进这里！
#
# 飞书插件市场的审核**不会替开发者执行 npm run build**，而是直接检查
# 仓库里有没有构建产物。首次提交审核时的驳回意见就是：
#   「部署失败: 输出目录 'dist' 未找到，请开发者 npm run build 之后将产物一同提交」
#
# 所以每次改了源码，都要 `npm run build` 并把 dist/ 一起提交，
# 否则审核拿到的是旧版本（或直接失败）。

# 构建产物与临时缓存
*.log
.DS_Store
.vite/
vite.config.ts.timestamp-*.mjs

# 测试编译产物（esbuild 生成，跑测试时自动重建）
test/*.cjs
test/*.mjs

# 隧道代理运行日志
.bridge.log
.push.log
.probe*.log
.lsr.log

# 表单长截图切片（临时候图，用后即删）
.formimg/

# 图标预览/调试产物
.iconpreview/
.iconpreview-final/

# 本地环境，不要提交
.env
.env.local
.env.*.local

# 编辑器
.vscode/
.idea/
